# SERVER
APP_NAME=MOM Generator
ENVIRONMENT=development
PORT=8010
LOG_LEVEL=INFO
INTERNAL_API_KEY=change-me-long-random-string
CORS_ORIGINS=["http://localhost:3000"]

# DATABASE, on the VM this is doe-postgres, 5432, attendee-mom, reachable only from Docker there
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=mom_generator
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=

# ATTENDEE
ATTENDEE_BASE_URL=http://localhost:8000
ATTENDEE_API_KEY=
ATTENDEE_WEBHOOK_SECRET=
ATTENDEE_WEBHOOK_URL=https://vivek-mom.ngrok-free.app/api/webhooks/attendee
ATTENDEE_BOT_NAME=TCG Notetaker
# Choose closed_captions, openai, or deepgram. Restart the backend after changing this.
TRANSCRIPTION_PROVIDER=closed_captions
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# MICROSOFT TEAMS CALENDAR
# The Entra app needs Calendars.Read application permission and admin consent.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TEAMS_CALENDAR_ENABLED=false
TEAMS_CALENDAR_MAILBOX=MOM@tcgdigital.com
TEAMS_CALENDAR_POLL_SECONDS=60
TEAMS_CALENDAR_LOOKAHEAD_DAYS=28

# OPENAI
OPENAI_API_KEY=
OPENAI_MOM_MODEL=gpt-5.4
OPENAI_MOM_REASONING_EFFORT=low

# EMAIL
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=mom@tcg.com
SMTP_PASSWORD=
SMTP_START_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=mom@tcg.com
SMTP_FROM_NAME=TCG Meeting Notes
ALLOWED_EMAIL_DOMAINS=["tcg.com"]
DEFAULT_MOM_EMAIL=meetings@tcg.com
