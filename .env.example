# Values docker-compose.yml reads at the repo root. Each app keeps its own secrets in attendee/.env and backend/.env.

# VM public IP or domain, used for Attendee links and allowed hosts
PUBLIC_HOST=your-vm-ip-or-domain

FRONTEND_PORT=9901
BACKEND_PORT=9902
ATTENDEE_PORT=9903

ATTENDEE_DB_NAME=attendee
ATTENDEE_DB_USER=attendee
ATTENDEE_DB_PASSWORD=change-me-long-random-string

# Docker network of doe-postgres, the backend database server on the VM
DB_NETWORK=doe-net

# Must match INTERNAL_API_KEY in backend/.env, nginx adds it to every /api call
BACKEND_API_KEY=change-me-long-random-string

# Attendee's public domain when a reverse proxy such as openresty serves it over HTTPS, leave empty otherwise
ATTENDEE_DOMAIN=
