# FastAPI backend that the Vite proxy forwards /api and /health to.
BACKEND_PROXY_TARGET=http://127.0.0.1:8010

# Must match INTERNAL_API_KEY in backend/.env. The proxy sends it, the browser never sees it.
BACKEND_API_KEY=

# Browser calls go through the proxy, keep this relative so the API key gets attached.
API_BASE_URL=/api
